<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_activated="true">
        <layer-list>
            <item android:bottom="-5dp" android:left="-5dp" android:right="-5dp" android:top="-5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2200E5FF" />
                    <stroke android:width="5dp" android:color="@color/favorite_selected" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke
                android:width="3dp"
                android:color="@color/accent_primary" />
            <solid android:color="#20E50914" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
