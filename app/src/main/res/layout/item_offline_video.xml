<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/apk/res/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:background="#151515"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="10dp">

    <!-- Rounded Poster container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_poster"
        android:layout_width="100dp"
        android:layout_height="60dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/glide_fallback_cover" />

    </androidx.cardview.widget.CardView>

    <!-- Info Column -->
    <TextView
        android:id="@+id/tv_video_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tv_progress_percent"
        app:layout_constraintStart_toEndOf="@id/cv_poster"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Breaking Bad" />

    <TextView
        android:id="@+id/tv_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@+id/tv_status"
        app:layout_constraintStart_toEndOf="@id/cv_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_video_title"
        tools:text="Temporada 1 • Episodio 3" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_download"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_status"
        app:layout_constraintStart_toEndOf="@id/cv_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_metadata"
        tools:progress="60" />

    <!-- Download percent -->
    <TextView
        android:id="@+id/tv_progress_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#66FFFFFF"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="60%" />

    <!-- Status indicator (Completed, Paused, etc.) -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FF9800"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_progress_percent"
        tools:text="Descargando" />

</androidx.constraintlayout.widget.ConstraintLayout>
